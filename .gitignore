# ---------------------------------------------------------------------------
# Never commit a store's settings, reports or logs.
# Each store keeps these locally; `git pull` leaves ignored files untouched.
# ---------------------------------------------------------------------------

# Per-store settings - hold the device IP and the sync key
store_config.ini
!store_config.example.ini

# Reports are data, not code
attendance_reports/
*.xlsx
*.xls
*.csv

# Logs written by the scripts
*_log.txt

# Server: local files when run outside Railway
uploads/
instance/

# Store: marks that the first full sync was accepted
.full_sync_done

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
